# RationSmart v4.0 — required environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=postgres
POSTGRES_HOST=your_db_host
POSTGRES_PORT=9900

# ── SMTP (Gmail App Password) ─────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=rationsmart.ucd@gmail.com
SMTP_PASSWORD=your_16char_gmail_app_password
FROM_EMAIL=rationsmart.ucd@gmail.com
FROM_NAME="RationSmart Feed Formulation"

# ── AWS S3 — Phase 5 replaces these with Azure Blob Storage ──────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=ucd-reports

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED — app will not start without this. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_64_char_hex_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Optimization ──────────────────────────────────────────────────────────────
# Number of worker processes for the optimization pool.
# Default: max(1, cpu_count - 1). Keep small on low-CPU containers.
# OPTIMIZATION_POOL_WORKERS=2

# Set to "true" to allow recommendations even when the optimizer
# cannot find a fully feasible diet.
ALLOW_INFEASIBLE_REPORTS=false

# Set to "true" to print NSGA-III iteration output to stdout (debug only).
NSGA3_VERBOSE=false

# ── PIN migration ─────────────────────────────────────────────────────────────
# Forces all existing 4-digit SHA-256 users to reset their PIN on next login.
FORCE_PIN_RESET_FOR_LEGACY_USERS=true

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://app.rationsmart.com,https://dev.rationsmart.com

# ── App ───────────────────────────────────────────────────────────────────────
WORKERS=3
