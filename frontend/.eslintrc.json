{
  "extends": [
    "next/core-web-vitals",
    "plugin:@typescript-eslint/recommended"
  ],
  "rules": {
    "@next/next/no-img-element": "off",
    "no-console": [
      "warn",
      {
        "allow": [
          "error",
          "debug"
        ]
      }
    ],
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/__tests__/**",
        "*.test.ts",
        "*.test.tsx"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "plugins": [
    "@typescript-eslint"
  ]
}
