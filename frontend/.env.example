# Copy to .env.development (dev) or set on the Vercel project (deploys).
# Required — the proxy refuses to start requests without them.
BACKEND_HOST=<backend-host>
BACKEND_PORT=8000
# http until the backend has TLS in front of it; then set to https (audit A-02).
BACKEND_PROTOCOL=http
# Label surfaced in the x-backend-env response header (dev | prod | custom).
BACKEND_ENV=dev
# Set to "true" on the testing deployment to skip the service worker.
# DISABLE_PWA=true
# Opt-in verbose API logging in the browser console. Never enable on a
# deployment real users reach — it prints request/response bodies.
# NEXT_PUBLIC_DEBUG_API=true
