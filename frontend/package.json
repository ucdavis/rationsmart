{
  "name": "rationsmart-pwa",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "next lint --max-warnings 0",
    "lint:promises": "eslint --no-eslintrc --no-inline-config -c .eslintrc.promises.js \"src/**/*.{ts,tsx}\" --ignore-pattern \"**/__tests__/**\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "axios": "^1.18.1",
    "exceljs": "^4.4.0",
    "next": "^14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.51.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "jsdom": "^23.2.0",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
