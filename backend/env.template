# RationSmart server configuration TEMPLATE (placeholders only, no secrets).
# Copy it to backend/.env and replace every placeholder value (the example IP and the values that start with "CHANGE").
#
#   cp backend/env.template backend/.env
#   chmod 600 backend/.env
#
# Rules (they prevent the most common problems):
#   * Passwords: use only letters and digits. Special characters (@ / ? # : % $) break connection strings.
#     Generate one with:   openssl rand -hex 16
#   * Write each setting as NAME=value on one line: no spaces around "=", no quotes, and no comment on the same line.
#   * Never commit backend/.env. It is already git-ignored.
# Every setting is explained in CONFIGURATION.md.

# ── Database (your managed PostgreSQL) ──────────────────────────────────────────
# Server name from your cloud provider, for example myserver.postgres.database.azure.com
POSTGRES_HOST=CHANGE_ME_database_server_name
POSTGRES_PORT=5432
# The database user and password you created in step 2 of DEPLOYMENT.md
POSTGRES_USER=rs_app
POSTGRES_PASSWORD=CHANGE_ME_database_password
POSTGRES_DB=rationsmart
# Encrypt the connection to the database (leave as it is)
PGSSLMODE=require

# ── Redis (runs inside the stack, nothing to install) ───────────────────────────
# Filled in automatically by a command in step 4 of DEPLOYMENT.md
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── Security ────────────────────────────────────────────────────────────────────
# Filled in automatically by a command in step 4 of DEPLOYMENT.md
JWT_SECRET_KEY=CHANGE_ME_secret_key

# ── The address people use to open the app: http:// plus your server's public IP or DNS name ──
# 127.0.0.1 below is only a placeholder (it means "this machine only"): replace it with your server's address.
# No trailing slash. Both lines must be the same address.
API_BASE_URL=http://127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1

# ── Email (sends the "verify your email" message) ───────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# Your email account and its password (Gmail: use an app password)
SMTP_USERNAME=CHANGE_ME@example.org
SMTP_PASSWORD=CHANGE_ME_email_password
# The sender address users will see
FROM_EMAIL=CHANGE_ME@example.org

# ── Container images (optional) ─────────────────────────────────────────────────
# Where ./deploy.sh downloads the ready-made images from. ghcr.io/your-org is a placeholder:
# nothing is published there, so the images are built on the server. Set your own to pull instead.
IMAGE_REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest
