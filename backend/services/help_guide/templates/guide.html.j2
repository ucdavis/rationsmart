<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>RationSmart {{ tr('guide_title') }}</title>
<meta name="author" content="RationSmart">
<style>{{ css|safe }}</style>
</head>
<body>

{# ── cover ── #}
<section class="cover">
  <div class="cover-band">
    <div class="brand">RationSmart</div>
    <h1>{{ tr('guide_title') }}</h1>
    <div class="tag">{{ tr('guide_tagline') }}</div>
  </div>
  <div class="cover-stripe"></div>
  <div class="cover-body">
    {% if quick.video %}<img class="cover-poster" src="{{ quick.video.poster }}" alt="">{% endif %}
    <div class="cover-meta">
      <div class="facts">
        <div><b>{{ tr('fact_language') }}</b> {{ language }}</div>
        <div><b>{{ tr('fact_edition') }}</b> {{ edition }}</div>
        <div><b>{{ tr('fact_updated') }}</b> {{ updated }}</div>
        <div><b>{{ tr('fact_topics') }}</b> {{ tr('fact_topics_value', count=topics|length) }}</div>
      </div>
      {% if quick.video %}
      <div class="scan"><img src="{{ quick.video.qr }}" alt="">{{ tr('cover_scan_1') }}<br>{{ tr('cover_scan_2', length=quick.video.length) }}</div>
      {% endif %}
    </div>
    {% if translation %}
    <div class="cover-note">{% if translation.status == 'ai_draft' %}<b>{{ tr('ai_note') }}</b>{% if tr('ai_note') != en('ai_note') %} {{ en('ai_note') }}{% endif %}<br>{% endif %}{{ tr('translated_from', edition=translation.from) }}</div>
    {% endif %}
  </div>
  <div class="cover-foot">{{ tr('cover_foot') }}</div>
</section>

{# ── how to use ── #}
<section class="front">
  <h2>{{ tr('howto_title') }}</h2>
  <div class="howto">
    <div><div class="ico">{{ topics[0].number }}–{{ topics[-1].number }}</div><div class="txt"><b>{{ tr('howto_topics_lead') }}</b> {{ tr('howto_topics') }}</div></div>
    <div><div class="ico">▦</div><div class="txt"><b>{{ tr('howto_scan_lead') }}</b> {{ tr('howto_scan') }}{% if lang != 'en' %} {{ tr('videos_english') }}{% endif %}</div></div>
    <div><div class="ico">▶</div><div class="txt"><b>{{ tr('howto_time_lead') }}</b> {{ tr('howto_time') }}</div></div>
    <div><div class="ico">⚠</div><div class="txt"><b>{{ tr('howto_problems_lead') }}</b> {{ tr('howto_problems') }}</div></div>
  </div>
  <div class="tip"><b>{{ tr('tip_lead') }}</b> {{ tr('tip', number=quick.number, title=italic(quick.title)) }}</div>
</section>

{# ── contents ── #}
<section class="front">
  <h2>{{ tr('contents_title') }}</h2>
  <div class="toc">
    {% for t in topics %}
    <a href="#t-{{ t.key }}"><span class="n">{{ t.number }}</span>{{ t.title }}{% if t.video %}<span class="len">▶ {{ t.video.length }}</span>{% endif %}</a>
    {% endfor %}
    {% if faqs %}
    <a class="extra" href="#faqs"><span class="n">?</span>{{ tr('faqs_title') }}</a>
    {% endif %}
    <a class="extra" href="#more"><span class="n">+</span>{{ tr('more_title') }}</a>
  </div>
</section>

{# ── topics ── #}
{% for t in topics %}
<section class="topic" id="t-{{ t.key }}">
  <div class="topic-head">
    <div class="topic-num"><span>{{ t.number }}</span></div>
    <div>
      <h2>{{ t.title }}</h2>
      <div class="summary">{{ t.summary }}</div>
      <div class="chips"><span class="chip">{{ tr('screen_chip', screen=t.screen_label) }}</span>{% if t.audience %}<span class="chip aud">{{ t.audience }}</span>{% endif %}</div>
    </div>
  </div>

  {% if t.video %}
  <div class="video">
    <div class="poster"><img src="{{ t.video.poster }}" alt=""><div class="len">{{ tr('video_length', length=t.video.length) }}</div></div>
    <div class="chap">
      <h3>{{ tr('in_the_video') }}</h3>
      <ol>{% for c in t.video.chapters %}<li><span class="t">{{ c.at }}</span>{{ c.label }}</li>{% endfor %}</ol>
    </div>
    <div class="scan"><img src="{{ t.video.qr }}" alt="">{{ tr('scan_to_watch') }}<br>{{ t.video.short }}</div>
  </div>
  {% endif %}

  <div class="steps">
    {% for s in t.steps %}
    <div class="step">
      <div class="no"><span>{{ loop.index }}</span></div>
      <div class="txt">
        {% if s.at %}<span class="at">▶ {{ s.at }}</span>{% endif %}
        {{ s.text }}
      </div>
      {% if s.image %}<div class="pic"><img src="{{ s.image }}" alt=""></div>{% endif %}
    </div>
    {% endfor %}
  </div>

  {% if t.problems %}
  <div class="problems">
    <h3>{{ tr('problems_title') }}</h3>
    {% for p in t.problems %}<div class="p"><b>{{ p.title }}</b><br>{{ p.text }}</div>{% endfor %}
  </div>
  {% endif %}
</section>
{% endfor %}

{# ── FAQs (the Admin Guide has none) ── #}
{% if faqs %}
<section class="topic faqs" id="faqs">
  <h2>{{ tr('faqs_title') }}</h2>
  {% for f in faqs %}
  <div class="faq">
    <div class="qq">{{ f.question }}</div>
    <div>{{ f.answer }}</div>
    {% if f.topic_title %}<div class="see">{{ tr('faq_see', number=f.topic_number, title=f.topic_title) }}</div>{% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}

{# ── back page ── #}
<section class="back" id="more">
  <h2>{{ tr('more_title') }}</h2>
  <div class="box"><h3>{{ tr('back_app_title') }}</h3>{{ tr('back_app') }}</div>
  <div class="box"><h3>{{ tr('back_contact_title') }}</h3>{{ tr('back_contact') }}</div>
  <div class="box"><h3>{{ tr('back_videos_title') }}</h3>{{ tr('back_videos', count=videos) }}</div>
  <div class="box"><h3>{{ tr('back_edition_title') }}</h3>{{ tr('back_edition', edition=edition, language=language, updated=updated) }}{% if translation %} {{ tr('translated_from', edition=translation.from) }}{% endif %}</div>
</section>

</body>
</html>
