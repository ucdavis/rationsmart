<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>RationSmart {{ tr('card_title') }}</title>
<style>{{ css|safe }}</style>
</head>
<body{% if compact %} class="compact"{% endif %}>
<section class="card">
  <div class="card-head">
    <div>
      <div class="brand">RationSmart</div>
      <h1>{{ tr('card_title') }}</h1>
      <div class="tag">{{ tr('card_tagline', count=quick.steps|length) }}</div>
    </div>
    {% if quick.video %}<div class="scan"><img src="{{ quick.video.qr }}" alt="">{{ tr('scan_to_watch') }}<br>({{ quick.video.length }})</div>{% endif %}
  </div>

  <div class="grid">
    {% for pair in quick.steps|batch(2) %}
    <div class="row">
      {% for s in pair %}
      <div class="cell">
        <div class="no"><span>{{ s.n }}</span><b>{{ s.title }}</b>{% if s.at %} <span class="at">▶ {{ s.at }}</span>{% endif %}</div>
        <p>{{ s.text }}</p>
        {% if s.image %}<img src="{{ s.image }}" alt="">{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</section>

<section class="card card2">
  <h2>{{ tr('card_problems_title') }}</h2>
  <div class="problems" style="margin-top:0">
    {% for p in quick.problems %}<div class="p"><b>{{ p.title }}</b><br>{{ p.text }}</div>{% endfor %}
  </div>

  <h2>{{ tr('card_faqs_title') }}</h2>
  {% for f in quick_faqs %}
  <div class="faq"><div class="qq">{{ f.question }}</div><div>{{ f.answer }}</div></div>
  {% endfor %}

  <h2>{{ tr('card_topics_title', count=topics|length) }}</h2>
  <ul class="list13">
    {% for t in topics %}<li><span class="n">{{ t.number }}</span>{{ t.title }}</li>{% endfor %}
  </ul>
  <div class="more">{{ tr('card_more') }}</div>
  {% if translation %}
  <div class="card-note">{% if translation.status == 'ai_draft' %}{{ tr('ai_note') }} {% if tr('ai_note') != en('ai_note') %}{{ en('ai_note') }} {% endif %}{% endif %}{{ tr('translated_from', edition=translation.from) }}</div>
  {% endif %}
</section>
</body>
</html>
