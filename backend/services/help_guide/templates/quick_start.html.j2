<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>RationSmart Quick Start</title>
<style>{{ css|safe }}</style>
</head>
<body>
<section class="card">
  <div class="card-head">
    <div>
      <div class="brand">RationSmart</div>
      <h1>Quick Start</h1>
      <div class="tag">From login to the cheapest diet, in {{ quick.steps|length }} steps</div>
    </div>
    {% if quick.video %}<div class="scan"><img src="{{ quick.video.qr }}" alt="">Scan to watch<br>({{ quick.video.length }})</div>{% endif %}
  </div>

  <div class="grid">
    {% for pair in quick.steps|batch(2) %}
    <div class="row">
      {% for s in pair %}
      <div class="cell">
        <div class="no"><span>{{ s.n }}</span><b>{{ s.title }}</b>{% if s.at %} <span class="at">▶ {{ s.at }}</span>{% endif %}</div>
        <p>{{ s.text }}</p>
        {% if s.image %}<img src="{{ s.image }}" alt="">{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</section>

<section class="card card2">
  <h2>⚠ If something goes wrong</h2>
  <div class="problems" style="margin-top:0">
    {% for p in quick.problems %}<div class="p"><b>{{ p.title }}</b><br>{{ p.text }}</div>{% endfor %}
  </div>

  <h2>Questions people ask</h2>
  {% for f in quick_faqs %}
  <div class="faq"><div class="qq">{{ f.question }}</div><div>{{ f.answer }}</div></div>
  {% endfor %}

  <h2>Learn more: {{ topics|length }} help topics</h2>
  <ul class="list13">
    {% for t in topics %}<li><span class="n">{{ t.number }}</span>{{ t.title }}</li>{% endfor %}
  </ul>
  <div class="more">In the app: menu → 'Help &amp; Support'. Every topic has a short video. The full printable User Guide is in the same place.</div>
</section>
</body>
</html>
